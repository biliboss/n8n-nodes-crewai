{
  "name": "n8n-nodes-crewai-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for n8n-nodes-crewai v2 (TS nodes, shared schema, Python bridge placeholder).",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter n8n-nodes-crewai dev",
    "dev:visual": "pnpm --filter n8n-nodes-crewai dev:visual",
    "lint": "pnpm -r --filter './packages/*' lint",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\"",
    "n8n:up": "docker compose -f docker/n8n/docker-compose.yml up -d",
    "n8n:down": "docker compose -f docker/n8n/docker-compose.yml down",
    "n8n:logs": "docker compose -f docker/n8n/docker-compose.yml logs -f n8n",
    "visual:capture": "pnpm --filter n8n-nodes-crewai visual:capture"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
